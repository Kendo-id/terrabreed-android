<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FFE86C5D"/>
            <stroke android:width="3dp" android:color="#FFCA4F40"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFD97706"/>
            <stroke android:width="2dp" android:color="#FFB45309"/>
        </shape>
    </item>
</selector>
