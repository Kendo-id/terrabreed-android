<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_surface" app:titleTextColor="@color/text_primary"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Detail Sesi Inkubasi" android:textSize="16sp"
        android:textColor="@color/text_secondary" android:padding="24dp" android:gravity="center"/>
</LinearLayout>
