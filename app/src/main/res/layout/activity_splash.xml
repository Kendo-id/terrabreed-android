<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@color/bg_primary">

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="120dp" android:layout_height="120dp"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter"
        android:layout_marginBottom="28dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TerraBreed"
        android:textSize="30sp" android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-light" android:letterSpacing="0.04em"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SMART INCUBATOR"
        android:textSize="11sp" android:textColor="@color/accent_primary"
        android:letterSpacing="0.18em" android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"/>

    <ProgressBar
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginTop="52dp"
        android:indeterminateTint="@color/nav_active"
        style="?android:attr/progressBarStyleSmall"/>

</LinearLayout>
