<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- Sensor Cards Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="2"
                android:layout_marginBottom="10dp">

                <!-- Suhu -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="100dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/temp_card_bg" app:cardCornerRadius="16dp"
                    app:strokeColor="@color/chart_temp_line" app:strokeWidth="1dp" 
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_heater" android:layout_marginEnd="5dp"
                                app:tint="@color/chart_temp_line"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SUHU" android:textSize="9sp" android:textColor="@color/text_secondary"
                                android:letterSpacing="0.15" android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tv_temp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--°C" android:textSize="30sp"
                            android:textColor="@color/chart_temp_line" android:fontFamily="sans-serif-light"/>
                        <TextView android:id="@+id/tv_target_temp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Target --°C" android:textSize="10sp" android:textColor="@color/text_disabled"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Kelembapan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="100dp"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/humid_card_bg" app:cardCornerRadius="16dp"
                    app:strokeColor="@color/chart_humid_line" app:strokeWidth="1dp" 
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_humidifier" android:layout_marginEnd="5dp"
                                app:tint="@color/chart_humid_line"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="KELEMBAPAN" android:textSize="9sp" android:textColor="@color/text_secondary"
                                android:letterSpacing="0.15" android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tv_humid"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--%"  android:textSize="30sp"
                            android:textColor="@color/chart_humid_line" android:fontFamily="sans-serif-light"/>
                        <TextView android:id="@+id/tv_target_humid"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Target --%"  android:textSize="10sp" android:textColor="@color/text_disabled"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Session Card -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_session"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" android:visibility="gone"
                app:cardBackgroundColor="#0AD97706" app:cardCornerRadius="14dp"
                app:strokeColor="#33D97706" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="13dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_egg" android:layout_marginEnd="6dp"
                            app:tint="@color/accent_primary"/>
                        <TextView android:id="@+id/tv_session_label"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Sesi Inkubasi" android:textSize="12sp"
                            android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/pb_session"
                        android:layout_width="match_parent" android:layout_height="3dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:progress="67" android:progressTint="@color/accent_primary"
                        android:progressBackgroundTint="@color/bg_elevated"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aktuator Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp"
                app:strokeColor="@color/border" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="AKTUATOR" android:textSize="9sp"
                        android:textColor="@color/text_secondary" android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-medium" android:layout_marginBottom="10dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:singleLine="false" android:layout_marginBottom="10dp">

                        <com.google.android.material.chip.Chip android:id="@+id/chip_heater"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pemanas" app:chipIcon="@drawable/ic_heater"
                            app:chipIconTint="@color/text_secondary"
                            app:chipBackgroundColor="@color/bg_elevated"
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            app:chipCornerRadius="20dp" app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/border" style="@style/Widget.MaterialComponents.Chip.Action"/>

                        <com.google.android.material.chip.Chip android:id="@+id/chip_humidifier"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Humidifier" app:chipIcon="@drawable/ic_humidifier"
                            app:chipIconTint="@color/text_secondary"
                            app:chipBackgroundColor="@color/bg_elevated"
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            app:chipCornerRadius="20dp" app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/border" style="@style/Widget.MaterialComponents.Chip.Action"/>

                        <com.google.android.material.chip.Chip android:id="@+id/chip_fan"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kipas" app:chipIcon="@drawable/ic_fan"
                            app:chipIconTint="@color/text_secondary"
                            app:chipBackgroundColor="@color/bg_elevated"
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            app:chipCornerRadius="20dp" app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/border" style="@style/Widget.MaterialComponents.Chip.Action"/>

                        <com.google.android.material.chip.Chip android:id="@+id/chip_auto_mode"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto" app:chipIcon="@drawable/ic_settings"
                            app:chipIconTint="@color/text_secondary"
                            app:chipBackgroundColor="@color/bg_elevated"
                            android:textColor="@color/text_secondary" android:textSize="12sp"
                            app:chipCornerRadius="20dp" app:chipStrokeWidth="1dp"
                            app:chipStrokeColor="@color/border" style="@style/Widget.MaterialComponents.Chip.Action"/>
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Tray info row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_refresh" android:layout_marginEnd="6dp"
                            app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Posisi Rak"
                            android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_tray_pos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="11sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginTop="4dp">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp"
                            android:src="@drawable/ic_refresh" android:layout_marginEnd="6dp"
                            app:tint="@color/text_secondary"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Motor"
                            android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/tv_motor_state"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="stop" android:textSize="11sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="80dp"
                app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="16dp"
                app:strokeColor="@color/border" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="RIWAYAT SUHU" android:textSize="9sp"
                        android:textColor="@color/text_secondary" android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp"/>
                    <TextView android:id="@+id/tv_chart_empty"
                        android:layout_width="match_parent" android:layout_height="80dp"
                        android:text="Menunggu data..." android:textColor="@color/text_disabled"
                        android:textSize="12sp" android:gravity="center" android:visibility="visible"/>
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/temp_chart"
                        android:layout_width="match_parent" android:layout_height="140dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
