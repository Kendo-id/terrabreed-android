<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_bg_rounded">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🥚 INKUBASI" android:textSize="10sp" android:textColor="#FFADB5BD"
        android:letterSpacing="0.15" />
    <TextView android:id="@+id/tv_widget_species"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="--" android:textSize="16sp" android:textColor="#FFF8F9FA"
        android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/tv_widget_day_count"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="-- / -- hari" android:textSize="12sp" android:textColor="#FFD97706" />
    <ProgressBar android:id="@+id/pb_widget_incubation"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="6dp" android:max="100" android:progress="0" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/tv_widget_remaining"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="-- hari lagi" android:textSize="10sp" android:textColor="#FF6C757D" />
        <TextView android:id="@+id/tv_widget_progress"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--%"  android:textSize="10sp" android:textColor="#FFD97706" />
    </LinearLayout>
    <TextView android:id="@+id/tv_widget_eggs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="9sp" android:textColor="#FF6C757D" />
    <TextView android:id="@+id/tv_widget_update_time"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="--:--" android:textSize="9sp" android:textColor="#4DFFFFFF"
        android:layout_marginTop="2dp" />
</LinearLayout>
