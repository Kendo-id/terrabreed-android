<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_surface"
        app:title="TERRA AI Voice"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <!-- Status bar -->
        <TextView android:id="@+id/tv_call_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Memuat..." android:textSize="14sp" android:textColor="@color/text_secondary"
            android:padding="16dp" android:textAlignment="center" android:background="@color/bg_surface"
            android:gravity="center" android:minLines="2" />
        <!-- Chat scroll -->
        <ScrollView android:id="@+id/scroll_chat"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:padding="12dp"
            android:fillViewport="true">
            <LinearLayout android:id="@+id/chat_container"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp" />
        </ScrollView>
        <!-- Voice controls -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="200dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@color/bg_surface" android:paddingTop="16dp" android:paddingBottom="16dp">
            <!-- Lottie wave (placeholder as TextView) -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_wave"
                android:layout_width="120dp" android:layout_height="40dp"
                android:visibility="invisible"
                app:lottie_rawRes="@raw/wave_animation"
                app:lottie_autoPlay="false"
                app:lottie_loop="true" />
            <!-- Pulse ring -->
            <FrameLayout android:layout_width="120dp" android:layout_height="120dp"
                android:layout_marginTop="8dp">
                <View android:id="@+id/pulse_ring"
                    android:layout_width="120dp" android:layout_height="120dp"
                    android:background="@drawable/pulse_ring"
                    android:visibility="gone" />
                <Button android:id="@+id/btn_push_to_talk"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_mic_button"
                    android:textSize="32sp"
                    android:text="" />
                <TextView android:id="@+id/tv_mic_icon"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:textSize="36sp" android:textAlignment="center"
                    android:gravity="center" android:text="🎤"
                    android:clickable="false" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tahan untuk bicara · Lepas untuk kirim"
                android:textSize="11sp" android:textColor="@color/text_disabled"
                android:textAlignment="center" android:layout_marginTop="8dp" />
        </LinearLayout>
        <!-- Bottom actions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp" android:background="@color/bg_surface">
            <Button android:id="@+id/btn_clear_chat"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Hapus Chat" android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/border"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btn_end_call"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Akhiri" android:textSize="12sp"
                android:backgroundTint="@color/status_error"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
